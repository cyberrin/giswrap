<?xml version="1.0" encoding="utf-8"?>
<!--
  The outgoing face. Slightly shorter than the incoming one so the two overlap
  rather than crossing at half opacity, which on a translucent panel would show
  the wallpaper through the middle of the transition.
-->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="240"
    android:fromAlpha="1.0"
    android:interpolator="@android:interpolator/fast_out_slow_in"
    android:toAlpha="0.0" />
`