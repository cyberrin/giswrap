<?xml version="1.0" encoding="utf-8"?>
<!--
  English is the default so that any non-Russian device falls back to it. The
  Russian translation lives in values-ru/ and is selected by the system for a
  Russian locale, or by the in-app language setting.

  Condition text ("Overcast, rain") is not here: it arrives from Gismeteo in
  Russian and is regenerated in English from the decoded Sky, in Conditions.kt.
-->
